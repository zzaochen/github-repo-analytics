{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/check-trending?period=daily",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/check-trending?period=weekly",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/check-trending?period=monthly",
      "schedule": "0 13 * * *"
    }
  ]
}
